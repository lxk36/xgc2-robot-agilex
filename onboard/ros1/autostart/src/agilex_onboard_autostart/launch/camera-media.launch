<launch>
  <!-- Scout product camera: V4L2 owner publishes /d435/image_raw, then
       ros_image_rtp encodes H264/RTP for Media Edge. Do not also start
       webrtc.launch (native V4L2) on the same USB. -->
  <arg name="camera_ns" default="d435" />
  <arg name="video_device" default="/dev/v4l/by-id/usb-Intel_R__RealSense_TM__Depth_Camera_435_Intel_R__RealSense_TM__Depth_Camera_435-video-index0" />
  <arg name="image_topic" default="/d435/image_raw" />
  <include file="$(find agilex_onboard_autostart)/launch/camera.launch">
    <arg name="camera_ns" value="$(arg camera_ns)" />
    <arg name="video_device" value="$(arg video_device)" />
  </include>
  <include file="$(find xgc2_camera_driver)/launch/ros_image_rtp.launch">
    <arg name="image_topic" value="$(arg image_topic)" />
    <arg name="source_id" value="color" />
    <arg name="frame_id" value="d435_optical_frame" />
    <arg name="width" value="640" />
    <arg name="height" value="480" />
    <arg name="rtp_port" value="5004" />
    <arg name="control_socket" value="/tmp/xgc2/media/color.sock" />
  </include>
</launch>
